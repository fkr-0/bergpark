{
  "name": "bergpark-wilhelmshoehe-guide",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "Offline-first bilingual PWA visitor guide for Bergpark Wilhelmshöhe",
  "scripts": {
    "predev": "node scripts/copy-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-data.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:py": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run test:py && npm run build",
    "check:e2e": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
